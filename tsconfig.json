{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "outDir": "dist",
    "strict": false,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/index.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "./**/*.test.ts"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
